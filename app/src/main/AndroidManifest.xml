<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.boringdroid.systemui"
    android:sharedUserId="android.uid.systemui">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- SystemUI's process needs FORCE_STOP_PACKAGES so the plugin's
         `SystemUIOverlay.refreshHomeLauncherForNewInsets` can kick the home
         launcher after attaching the taskbar window — Launcher3 caches its
         DeviceProfile from the WindowInsets at first onAttach, so without a
         restart the Hotseat icons end up drawn under the taskbar. The grant
         reaches the SystemUI process because this APK joins
         `sharedUserId="android.uid.systemui"`; the matching privapp-permissions
         allowlist lives at vendor/boringdroid/permissions/. Signature|privileged. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- PluginEnableReceiver re-enables the SystemUIOverlay component
         after a SystemUI crash auto-disables it (and after dev `adb install -r`
         of this APK). Auto-granted for preinstalled platform-signed apps. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />
    <!-- BoringdroidOverviewService runs as a plain Service in the plugin's
         own process (outside the SystemUI host) and drives a WindowManager
         window of TYPE_APPLICATION_OVERLAY. Auto-granted for preinstalled
         platform-signed apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- ActivityManagerWrapper.getTaskThumbnail routes through
         ActivityTaskManagerService.getTaskSnapshot, which enforces
         READ_FRAME_BUFFER. Signature-level, auto-granted for platform-signed
         apps. -->
    <uses-permission android:name="android.permission.READ_FRAME_BUFFER" />
    <!-- TaskStackChangeListeners.registerTaskStackListener enforces
         MANAGE_ACTIVITY_TASKS (signature|recents). Used to repaint overview
         cards when the system publishes a fresh TaskSnapshot while the
         overview is visible. -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <!-- Overview card click handler calls
         ActivityManagerWrapper.startActivityFromRecents, which enforces
         START_TASKS_FROM_RECENTS (signature|privileged|recents). -->
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />
    <!-- Overview card close ("×") button calls ActivityManagerWrapper.removeTask,
         which enforces REMOVE_TASKS (signature|privileged|recents). -->
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <!-- The Calendar & Clock panel queries CalendarContract.Instances to render
         the "Today's agenda" list. The plugin runs in the SystemUI process
         (uid=1000), which holds READ_CALENDAR by signature on userdebug. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application tools:ignore="AllowBackup,MissingApplicationIcon">
        <service
            android:name="com.boringdroid.systemui.SystemUIOverlay"
            android:label="@string/system_ui_overlay_name"
            android:largeHeap="true"
            android:exported="true"
            android:supportsRtl="false"
            tools:ignore="ExportedService,Instantiatable">
            <intent-filter>
                <action android:name="com.android.systemui.action.PLUGIN_OVERLAY" />
            </intent-filter>
        </service>

        <!-- Overview proxy bound by SystemUI once config_recentsComponentName
             points at this package. -->
        <service
            android:name="com.boringdroid.systemui.overview.BoringdroidOverviewService"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.QUICKSTEP_SERVICE" />
            </intent-filter>
        </service>

        <!-- Mirrors every active StatusBarNotification into NotificationFeed so the
             action center window can render them. Bound by system_server when the
             user (or `cmd notification allow_listener ...` on userdebug) grants
             notification-listener access. -->
        <service
            android:name="com.boringdroid.systemui.actioncenter.BoringdroidNotificationMirror"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Re-enables the SystemUIOverlay component if the SystemUI host has
             auto-disabled it after a crash, or after this APK is replaced via
             `adb install -r`. Lives in a separate component so its receiver
             stays deliverable even when the overlay component is disabled. -->
        <receiver
            android:name="com.boringdroid.systemui.PluginEnableReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Manifest-declared receiver so the taskbar's recents button can reach the
             Overview window even before BoringdroidOverviewService has been bound by
             SystemUI's OverviewProxyService. On receipt it starts the service and
             forwards the action through; the service's own in-process receiver then
             drives the OverviewWindow. -->
        <receiver
            android:name="com.boringdroid.systemui.overview.OverviewToggleReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.boringdroid.systemui.action.TOGGLE_OVERVIEW" />
                <action android:name="com.boringdroid.systemui.action.HIDE_OVERVIEW" />
            </intent-filter>
        </receiver>
    </application>

</manifest>